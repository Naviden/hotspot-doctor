# ── tiny terminal helpers ────────────────────────────────────────────────────
TTY = sys.stdout.isatty()


def c(code, s):
    return f"\033[{code}m{s}\033[0m" if TTY else s


dim = lambda s: c("2", s)
bold = lambda s: c("1", s)
red = lambda s: c("31", s)
green = lambda s: c("32", s)
yellow = lambda s: c("33", s)
cyan = lambda s: c("36", s)


def run(cmd, timeout=6, merge=False):
    """Run a command, return stdout ('' on any failure). Never raises.

    merge=True also folds in stderr, which `ping` uses for the errors that
    matter to MTU probing ('Message too long').
    """
    try:
        p = subprocess.run(cmd, capture_output=True, timeout=timeout, check=False)
    except (subprocess.SubprocessError, OSError):
        return ""
    # Decode by hand rather than text=True: whois servers serve latin-1 and
    # other legacy encodings, and text=True raises UnicodeDecodeError from
    # inside subprocess before we ever see the bytes.
    def dec(b):
        return (b or b"").decode("utf-8", "replace")
    return dec(p.stdout) + dec(p.stderr) if merge else dec(p.stdout)


# ── what the link actually is ────────────────────────────────────────────────
def link_info():
    """Default interface, gateway, MTU, hardware-port name, SSID."""
    info = {"iface": None, "gateway": None, "mtu": None, "port": None, "ssid": None}

    for line in run(["route", "-n", "get", "default"]).splitlines():
        line = line.strip()
        if line.startswith("interface:"):
            info["iface"] = line.split(":", 1)[1].strip()
        elif line.startswith("gateway:"):
            info["gateway"] = line.split(":", 1)[1].strip()

    if not info["iface"]:
        return info

    # hardware port name ("Wi-Fi", "iPhone USB", "Ethernet Adapter (en4)"...)
    port = None
    for block in run(["networksetup", "-listallhardwareports"]).split("\n\n"):
        if f"Device: {info['iface']}" in block:
            for line in block.splitlines():
                if line.startswith("Hardware Port:"):
                    port = line.split(":", 1)[1].strip()
    info["port"] = port

    m = re.search(rf"^{re.escape(info['iface'])}:.*?mtu (\d+)", run(["ifconfig", info["iface"]]), re.M)
    if m:
        info["mtu"] = int(m.group(1))

    if port == "Wi-Fi":
        out = run(["networksetup", "-getairportnetwork", info["iface"]])
        if ":" in out:
            info["ssid"] = out.split(":", 1)[1].strip()

    return info


def is_usb_tether(info):
    return bool(info["port"]) and "iPhone" in info["port"]


def is_hotspot(info):
    """iPhone Personal Hotspot hands out 172.20.10.x."""
    return bool(info["gateway"]) and info["gateway"].startswith("172.20.10.")


# ── throughput from interface byte counters ──────────────────────────────────
def counters(iface):
    """(bytes_in, bytes_out) for iface, or None."""
    for line in run(["netstat", "-ibn"]).splitlines():
        f = line.split()
        if len(f) >= 10 and f[0] == iface and f[2].startswith("<Link"):
            try:
                return int(f[6]), int(f[9])
            except ValueError:
                return None
    return None


def human_rate(bytes_per_sec):
    b = bytes_per_sec * 8.0
    for unit in ("bps", "Kbps", "Mbps", "Gbps"):
        if b < 1000:
            return f"{b:5.1f} {unit}"
        b /= 1000
    return f"{b:5.1f} Tbps"


# ── ping ─────────────────────────────────────────────────────────────────────
def ping_once(host, wait_ms=1500):
    """Round-trip ms, or None if lost."""
    out = run(["ping", "-c", "1", "-n", "-W", str(wait_ms), host],
              timeout=wait_ms / 1000.0 + 2)
    m = re.search(r"time=([\d.]+) ms", out)
    return float(m.group(1)) if m else None


class Track:
    """Rolling window of ping results for one target."""

    def __init__(self, name, host, size=60):
        self.name, self.host = name, host
        self.samples = deque(maxlen=size)  # None == lost

    def add(self, rtt):
        self.samples.append(rtt)

    @property
    def alive(self):
        return [s for s in self.samples if s is not None]

    @property
    def loss(self):
        return 100.0 * sum(s is None for s in self.samples) / len(self.samples) if self.samples else 0.0

    @property
    def median(self):
        a = sorted(self.alive)
        return a[len(a) // 2] if a else None

    @property
    def jitter(self):
        """Mean absolute change between consecutive successful pings."""
        a = self.alive
        if len(a) < 2:
            return None
        return sum(abs(a[i] - a[i - 1]) for i in range(1, len(a))) / (len(a) - 1)

    @property
    def dead(self):
        return len(self.samples) >= 3 and not self.alive


BARS = "▁▂▃▄▅▆▇█"
# Bars are drawn relative to each link's OWN baseline, not an absolute ms
# scale. An absolute scale painted a rock-steady 100ms cellular link solid
# red while the verdict said GOOD — the picture and the words disagreed, and
# the picture is what people believe. What actually hurts is *deviation*:
# a steady 100ms is fine, a 100ms link that spikes to 600ms is not.
RATIOS = (1.3, 1.7, 2.2, 3.0, 4.0, 5.5, 7.5)
BASELINE_FLOOR = 15.0  # ms; below this, small absolute wobbles aren't real
ABS_BAD, ABS_ROUGH = 600.0, 300.0  # a spike this big is bad on any link


def spark(samples, width, baseline=None):
    """Deviation from `baseline`, so calm links look calm at any latency."""
    base = max(baseline or 0.0, BASELINE_FLOOR)
    out = []
    for s in list(samples)[-width:]:
        if s is None:
            out.append(red("×"))
            continue
        level = sum(s / base > r for r in RATIOS)
        # Relative is the right lens, but don't let it excuse a genuinely
        # awful absolute number just because the link is always awful.
        if s > ABS_BAD:
            level = max(level, 6)
        elif s > ABS_ROUGH:
            level = max(level, 4)
        ch = BARS[level]
        out.append(green(ch) if level <= 1 else yellow(ch) if level <= 3 else red(ch))
    return "".join(out).rjust(width)


# ── verdict + diagnosis ──────────────────────────────────────────────────────
# One set of thresholds for both the badge and the summary. They used to carry
# their own: verdict() called 6% loss ROUGH while diagnose() only reacted above
# 10%, so the badge said ROUGH and the line under it said "nothing to do".
LOSS_ROUGH, LOSS_BAD = 5.0, 20.0
JITTER_ROUGH = 50.0
MEDIAN_ROUGH = 250.0


def verdict(t):
    if t.dead:
        return "DOWN", red
    if t.loss > LOSS_BAD:
        return "BAD", red
    med, jit = t.median, t.jitter
    if (t.loss > LOSS_ROUGH or (med and med > MEDIAN_ROUGH)
            or (jit and jit > JITTER_ROUGH)):
        return "ROUGH", yellow
    return "GOOD", green


# ── who you're actually connected through ────────────────────────────────────
def wifi_info():
    """Signal, band and PHY for the current Wi-Fi link. No sudo needed.

    This measures the hop to the phone — the half of the problem you can fix
    by moving the laptop, as opposed to the half you fix by moving the phone.
    """
    out = run(["system_profiler", "SPAirPortDataType"], timeout=15)
    _, _, rest = out.partition("Current Network Information:")
    if not rest:
        return {}
    blk, d = rest[:900], {}
    m = re.search(r"Signal\s*/\s*Noise:\s*(-?\d+)\s*dBm\s*/\s*(-?\d+)\s*dBm", blk)
    if m:
        d["rssi"], d["noise"] = int(m.group(1)), int(m.group(2))
        d["snr"] = d["rssi"] - d["noise"]
    m = re.search(r"PHY Mode:\s*(\S+)", blk)
    if m:
        d["phy"] = m.group(1)
    m = re.search(r"Channel:\s*(\d+)\s*\((\d+)GHz", blk)
    if m:
        d["channel"], d["band"] = int(m.group(1)), int(m.group(2))
    m = re.search(r"Transmit Rate:\s*(\d+)", blk)
    if m:
        d["txrate"] = int(m.group(1))
    return d


# ── nearby networks ──────────────────────────────────────────────────────────
# What a passive scan can and cannot tell you, stated once so the rest of the
# code doesn't have to pretend otherwise:
#   CAN  — encryption in use, signal, band, channel
#   CANNOT — who runs the access point, whether the operator is trustworthy,
#            or whether an SSID is an impostor. BSSIDs aren't exposed here, so
#            evil-twin detection is impossible. Encryption is not safety.
# Hence: rank risk, never certify "safe". `hotspot trust` is where the real
# answers live, because they require actually being on the network.
SEC_RANK = {
    "none":               (0, "OPEN"),
    "wep":                (0, "WEP (broken)"),
    "wpa personal":       (2, "WPA (obsolete)"),
    "wpa2 personal":      (3, "WPA2"),
    "wpa2/wpa3 personal": (4, "WPA2/WPA3"),
    "wpa3 personal":      (5, "WPA3"),
    "wpa2 enterprise":    (4, "WPA2 Enterprise"),
    "wpa3 enterprise":    (5, "WPA3 Enterprise"),
}


def wifi_scan():
    """Nearby networks. Returns (list, names_hidden).

    macOS 26 redacts SSIDs from processes without Location Services access,
    so the caller must be able to tell "no names" from "no networks".
    """
    out = run(["system_profiler", "SPAirPortDataType"], timeout=30)
    _, _, rest = out.partition("Other Local Wi-Fi Networks:")
    if not rest:
        return [], False
    rest = re.split(r"\n {8}[a-z]", rest)[0]  # ends at the next interface block
    nets, cur = [], None
    for line in rest.splitlines():
        s = line.strip()
        if not s:
            continue
        indent = len(line) - len(line.lstrip())
        if indent == 12 and s.endswith(":") and ": " not in s:
            cur = {"ssid": s[:-1]}
            nets.append(cur)
        elif cur is not None and ": " in s:
            k, _, v = s.partition(": ")
            cur[k.strip()] = v.strip()
    hidden = any(n["ssid"] == "<redacted>" for n in nets)
    return nets, hidden


def net_rank(n):
    """(security score, label, rssi) for one scanned network."""
    sec = n.get("Security", "").lower()
    score, label = SEC_RANK.get(sec, (1, n.get("Security") or "unknown"))
    m = re.match(r"(-?\d+)\s*dBm", n.get("Signal / Noise", ""))
    return score, label, (int(m.group(1)) if m else None)


def cmd_wifi(_args):
    nets, hidden = wifi_scan()
    if not nets:
        print(yellow("No other networks visible."))
        print(dim("  macOS may also be withholding the scan entirely — see "
                  "Location Services below."))
    else:
        print(f"{bold('nearby networks')}  {dim(f'({len(nets)} visible)')}\n")
        print(dim(f"  {'name':<20} {'encryption':<18} {'signal':<9} band"))
        rows = sorted(nets, key=lambda n: (net_rank(n)[0], net_rank(n)[2] or -999),
                      reverse=True)
        for n in rows:
            score, label, rssi = net_rank(n)
            ch = n.get("Channel", "")
            band = "5GHz" if "5GHz" in ch else "2.4GHz" if "2GHz" in ch else "?"
            _word, wcol = signal_words(rssi, None)
            sig = f"{rssi} dBm" if rssi is not None else "—"
            seccol = red if score == 0 else yellow if score <= 2 else green
            # Pad before colouring: escape codes have width 0 but len() > 0.
            name, lab, sg = n["ssid"][:19].ljust(20), label.ljust(18), sig.ljust(9)
            print(f"  {name} {seccol(lab)} {(wcol or dim)(sg)} {dim(band)}")
        print()

    if hidden:
        print(yellow("  Network names are hidden."))
        for line in wrap("macOS only reveals SSIDs to apps with Location "
                         "Services permission. Grant it to your terminal in "
                         "System Settings → Privacy & Security → Location "
                         "Services, then run this again.", 72):
            print(f"  {line}")
        print()

    print(dim("  Encryption is not safety. This tells you how traffic is"))
    print(dim("  protected in the air — not who runs the access point, nor"))
    print(dim("  whether an SSID is genuine. Once connected, `hotspot trust`"))
    print(dim("  checks whether the network is actually tampering with you."))
    return 0


IPV4_RE = re.compile(r"^\d{1,3}(?:\.\d{1,3}){3}$")


def public_ip():
    """Your address as the internet sees it.

    DNS first because it's the cheapest, then HTTPS: guest and corporate
    networks routinely block port 53 to outside resolvers, which silently
    killed this lookup on exactly the sort of network people run doctor on.
    """
    ip = run(["dig", "+short", "+time=3", "+tries=1",
              "myip.opendns.com", "@resolver1.opendns.com"], timeout=10)
    ip = ip.strip().split("\n")[0].strip()
    if IPV4_RE.match(ip):
        return ip
    try:
        req = urllib.request.Request("https://cloudflare.com/cdn-cgi/trace",
                                     headers={"User-Agent": "hotspot-doctor"})
        with urllib.request.urlopen(req, timeout=8) as r:
            body = r.read(2048).decode("utf-8", "replace")
        m = re.search(r"^ip=(\d{1,3}(?:\.\d{1,3}){3})$", body, re.M)
        return m.group(1) if m else ""
    except Exception:
        return ""


def carrier_info():
    """Which network you're actually egressing through, via DNS + whois.

    Deliberately not an HTTP geolocation API: one DNS query plus one whois is
    a few KB, needs no key, and sends nothing but the lookup itself.
    """
    ip = public_ip()
    if not ip:
        return {}
    d = {"ip": ip}
    w = run(["whois", ip], timeout=15)
    for pat, key in ((r"^org-?name:\s*(.+)$", "org"),
                     (r"^organization:\s*(.+)$", "org"),
                     (r"^netname:\s*(.+)$", "netname"),
                     (r"^descr:\s*(.+)$", "descr"),
                     (r"^country:\s*(.+)$", "country")):
        m = re.search(pat, w, re.I | re.M)
        if m and key not in d:
            d[key] = m.group(1).strip()
    name = d.get("org") or ""
    if not name and d.get("netname"):
        # FASTWEB-MBB -> Fastweb. Crude, but right far more often than not.
        name = d["netname"].split("-")[0].title()
    d["name"] = name or d.get("descr", "")[:40] or "unknown"
    return d


def speed_test(max_bytes=2_000_000, max_secs=6.0):
    """Bounded download. Returns (mbps, bytes, secs) or None.

    Capped on bytes AND seconds, because this spends the exact resource the
    rest of the tool exists to conserve. On a slow link the clock stops it
    early and the answer is still directionally right.
    """
    url = f"https://speed.cloudflare.com/__down?bytes={max_bytes}"
    try:
        req = urllib.request.Request(url, headers={"User-Agent": "hotspot-doctor"})
        n, t0 = 0, time.time()
        with urllib.request.urlopen(req, timeout=max_secs + 5) as r:
            while time.time() - t0 < max_secs:
                chunk = r.read(65536)
                if not chunk:
                    break
                n += len(chunk)
        dt = time.time() - t0
        if dt <= 0 or n < 50_000:
            return None
        return n * 8 / dt / 1e6, n, dt
    except Exception:
        return None


def signal_words(rssi, snr):
    """Plain words for a dBm number nobody should have to interpret."""
    if rssi is None:
        return "", None
    if rssi >= -60 and (snr or 99) >= 25:
        return "excellent", green
    if rssi >= -70:
        return "good", green
    if rssi >= -78:
        return "weak", yellow
    return "very weak", red


# ── is this network tampering with me? ───────────────────────────────────────
# These are the checks a scan cannot make. They all require being on the
# network, and each one tests a specific, falsifiable claim rather than
# producing a vibe.

# Deliberately not exhaustive — an unfamiliar issuer is a prompt to look, not
# proof of attack. Any corporate MITM whose root is installed in the system
# store will still validate; only the issuer name gives it away.
PUBLIC_CAS = (
    "digicert", "let's encrypt", "isrg", "google trust services", "sectigo",
    "globalsign", "amazon", "microsoft", "apple", "entrust", "godaddy",
    "cloudflare", "comodo", "baltimore", "verisign", "thawte", "geotrust",
    "starfield", "identrust", "buypass", "actalis", "certum", "zerossl",
)


def check_captive_portal(timeout=8):
    """Apple's own portal probe. Returns None if clean, else what came back."""
    url = "http://captive.apple.com/hotspot-detect.html"
    try:
        req = urllib.request.Request(
            url, headers={"User-Agent": "CaptiveNetworkSupport/1.0 wispr"})
        with urllib.request.urlopen(req, timeout=timeout) as r:
            body = r.read(4096).decode("utf-8", "replace")
            final = r.geturl()
    except urllib.error.HTTPError as e:
        return f"HTTP {e.code} instead of the expected page"
    except Exception as e:
        return f"unreachable ({type(e).__name__})"
    if "Success" in body:
        return None
    if final != url:
        return f"redirected to {final[:60]}"
    return "the response was altered"


def check_dns(timeout=6):
    """Two falsifiable DNS claims. Returns a list of problems (empty == clean).

    1. A name that cannot exist must not resolve. RFC 2606 reserves .invalid,
       and a random label under .com covers resolvers that special-case it.
    2. A name with a famously fixed address must resolve to that address.
    """
    problems = []
    rand = os.urandom(8).hex()
    for host in (f"{rand}.invalid", f"nx-{rand}.com"):
        try:
            addrs = socket.getaddrinfo(host, None, socket.AF_INET)
            ip = addrs[0][4][0] if addrs else "?"
            problems.append(
                f"made-up name {host[:22]}… resolved to {ip} — this resolver "
                f"hijacks failed lookups, usually to inject ads")
            break  # one demonstration is enough
        except socket.gaierror:
            pass
        except Exception:
            pass
    try:
        addrs = {a[4][0] for a in socket.getaddrinfo("one.one.one.one", None,
                                                     socket.AF_INET)}
        if addrs and not (addrs & {"1.1.1.1", "1.0.0.1"}):
            problems.append(
                f"one.one.one.one resolved to {sorted(addrs)[0]} instead of "
                f"1.1.1.1 — DNS answers are being rewritten")
    except Exception:
        pass
    return problems


def check_tls(host="cloudflare.com", timeout=8):
    """Returns (ok, issuer, detail). ok=False means look closely."""
    ctx = ssl.create_default_context()
    try:
        with socket.create_connection((host, 443), timeout=timeout) as sock:
            with ctx.wrap_socket(sock, server_hostname=host) as ss:
                cert = ss.getpeercert()
    except ssl.SSLCertVerificationError as e:
        return False, None, f"certificate did not verify — {e.verify_message}"
    except Exception as e:
        return None, None, f"couldn't check ({type(e).__name__})"
    issuer = dict(x[0] for x in cert.get("issuer", ()))
    org = issuer.get("organizationName") or issuer.get("commonName") or "unknown"
    known = any(ca in org.lower() for ca in PUBLIC_CAS)
    return known, org, None


# ── path MTU ─────────────────────────────────────────────────────────────────
# The failure this catches: pings are tiny, so a link whose large packets are
# being silently dropped still measures as perfectly healthy. Meanwhile every
# real transfer stalls — SSH hangs mid-session, pages half-load, git clone
# freezes at 99%. Cellular paths very often carry less than the 1500 bytes the
# interface claims, and nothing on the machine tells you.
IP_ICMP_OVERHEAD = 28  # 20-byte IPv4 header + 8-byte ICMP header
FULL_PAYLOAD = 1500 - IP_ICMP_OVERHEAD  # 1472


def df_ping(host, payload, timeout_ms=1200):
    """One don't-fragment ping. Returns (kind, mtu_hint).

    kind: 'ok' | 'frag' (router told us the limit) | 'toobig' (local NIC
    refused it) | 'lost' (silent drop — the black hole case).
    """
    out = run(["ping", "-D", "-n", "-c", "1", "-W", str(timeout_ms),
               "-s", str(payload), host],
              timeout=timeout_ms / 1000.0 + 2, merge=True)
    if "time=" in out:
        return "ok", None
    low = out.lower()
    if "message too long" in low:
        return "toobig", None
    m = re.search(r"mtu\s*=\s*(\d+)", low)
    if m:
        return "frag", int(m.group(1))
    return "lost", None


def mtu_capped(host=INTERNET, timeout_ms=1200):
    """Cheap yes/no: does a full-size packet get through? None if unknown.

    Two probes, not one — a single loss on a flaky link would otherwise read
    as an MTU cap. Used by `watch`, which can't afford the full search.
    """
    for _ in range(2):
        kind, _hint = df_ping(host, FULL_PAYLOAD, timeout_ms)
        if kind == "ok":
            return False
        if kind == "toobig":
            return True
    return True if kind == "lost" else None


def probe_mtu(host=INTERNET, timeout_ms=1200):
    """Find the real path MTU. Returns (mtu, kind).

    kind: 'ok' (full 1500 passes) | 'reduced' (mtu is real and below 1500)
          | 'down' (small pings fail too, so this isn't an MTU question)
          | 'unknown'
    """
    # Guard first: on a dead link every probe fails, and reporting that as an
    # MTU black hole would be confidently wrong.
    if not any(df_ping(host, 56, timeout_ms)[0] == "ok" for _ in range(3)):
        return None, "down"

    kind, hint = df_ping(host, FULL_PAYLOAD, timeout_ms)
    if kind == "ok":
        return 1500, "ok"
    if kind == "frag" and hint:
        return hint, ("ok" if hint >= 1500 else "reduced")

    # Silent drop. Nothing will tell us the limit, so bisect for it.
    lo, hi = 56, FULL_PAYLOAD  # lo known good, hi known bad
    # One probe at the IPv6 floor usually lifts the lower bound straight to
    # 1252 and saves ~4 rounds of slow timeouts. Falls back cleanly if the
    # path really is smaller than that.
    if df_ping(host, 1280 - IP_ICMP_OVERHEAD, timeout_ms)[0] == "ok":
        lo = 1280 - IP_ICMP_OVERHEAD
    while hi - lo > 1:
        mid = (lo + hi) // 2
        k, h = df_ping(host, mid, timeout_ms)
        if k == "frag" and h:
            return h, ("ok" if h >= 1500 else "reduced")
        if k == "ok":
            lo = mid
        elif k == "toobig":
            hi = mid
        else:
            # A lone drop may just be ordinary loss. Make it prove itself.
            k2, _ = df_ping(host, mid, timeout_ms)
            lo, hi = (mid, hi) if k2 == "ok" else (lo, mid)
    return lo + IP_ICMP_OVERHEAD, "reduced"


def diagnose(gw, net, info, mtu_bad=None, busy=False, paused=0):
    """What is wrong, and what to do about it.

    Returns (colour, headline, [actions]). Every branch ends in something the
    reader can actually do — the old version handed back measurements and left
    the interpreting to them, which is the part they were stuck on.
    """
    if not gw.samples or not net.samples:
        return None
    gw_ok = not gw.dead and gw.loss <= LOSS_ROUGH
    net_ok = not net.dead and net.loss <= LOSS_ROUGH

    if gw.dead and net.dead:
        return red, "Link is down.", [
            "check Personal Hotspot is still enabled on the phone",
            "toggle Wi-Fi off and on",
        ]

    if not gw_ok:
        if is_usb_tether(info):
            return red, "The USB tether itself is dropping.", [
                "reseat the cable, then try a different port",
            ]
        return red, "The Wi-Fi hop to your phone is the problem, not cellular.", [
            "move the Mac closer to the phone",
            "or plug in the USB cable — removes this hop entirely",
        ]

    if not net_ok:
        return red, "Your phone link is fine — the cellular side is dropping.", [
            "move the phone toward a window",
            "force LTE: Settings → Cellular → Cellular Data Options",
        ]

    # Everything passes the loss test. Now the things that still ruin the day.
    jit, med = net.jitter or 0, net.median or 0
    if jit > JITTER_ROUGH:
        acts = ["expect SSH and calls to stutter; large pages will feel slow"]
        if not paused:
            acts.append("hotspot calm — pause background sync, which makes jitter worse")
        acts.append("move the phone toward a window")
        return yellow, f"Latency is OK but unstable ({jit:.0f}ms jitter).", acts

    # Slow but steady is its own state, and the badge already calls it ROUGH —
    # so there has to be a branch for it or the two disagree again.
    if med > MEDIAN_ROUGH:
        return yellow, f"Everything is slow but steady ({med:.0f}ms).", [
            "you are far from the tower — move the phone toward a window",
            "force LTE: Settings → Cellular → Cellular Data Options",
        ]

    if mtu_bad:
        # Pings are small, so a path dropping full-size packets measures as
        # perfect here. Say that plainly rather than calling it healthy.
        return yellow, "Latency is fine, but full-size packets are being dropped.", [
            "large transfers will stall — SSH freezes, git hangs near the end",
            "hotspot mtu — find the limit and get the one-line fix",
        ]

    if busy and not paused:
        return yellow, "Link is fine, but something is using a lot of it.", [
            "hotspot calm — pause background sync",
        ]

    if paused:
        return green, "Link is stable. Nothing to do.", [
            f"{paused} process(es) still paused — hotspot restore when back on wifi",
        ]
    return green, "Link is stable. Nothing to do.", []


# ── calm / restore ───────────────────────────────────────────────────────────
# Reversible SIGSTOP. Deliberately excludes cloudd/photolibraryd — stopping
# those wedges Finder and Photos.
#
# App entries are anchored to their .app bundle path, not a bare name: a plain
# `pgrep -f "Google Drive"` also matches a browser tab or a shell command that
# merely mentions it, and suspending those would be a nasty surprise.
HOGS = [
    ("bird", "iCloud Drive sync", True),
    ("nsurlsessiond", "background downloads (App Store, iCloud)", True),
    ("photoanalysisd", "Photos analysis", True),
    ("mediaanalysisd", "Photos media analysis", True),
    ("softwareupdated", "macOS software update", True),
    ("/Dropbox[.]app/", "Dropbox", False),
    ("/Google Drive[.]app/", "Google Drive", False),
    ("/OneDrive[.]app/", "OneDrive", False),
    ("/Creative Cloud[.]app/", "Adobe Creative Cloud", False),
    ("/Adobe Desktop Service[.]app/", "Adobe background service", False),
    ("/Spotify[.]app/", "Spotify", False),
]


def find_pids(name, exact):
    flag = "-x" if exact else "-f"
    out = run(["pgrep", flag, "-U", str(os.getuid()), name])
    return [int(x) for x in out.split() if x.isdigit()]


def ancestors():
    """Our own pid and every parent up the tree — never signal these, or we'd
    freeze the shell (and terminal) that invoked us."""
    seen, pid = set(), os.getpid()
    while pid and pid > 1 and pid not in seen:
        seen.add(pid)
        ppid = run(["ps", "-o", "ppid=", "-p", str(pid)]).strip()
        pid = int(ppid) if ppid.isdigit() else 0
    return seen


def signal_hogs(sig):
    """Send sig to every hog we can. Returns [(label, pid)] that took it."""
    skip, hit = ancestors(), []
    for name, label, exact in HOGS:
        for pid in find_pids(name, exact):
            if pid in skip:
                continue
            try:
                os.kill(pid, sig)
                hit.append((label, pid))
            except (ProcessLookupError, PermissionError):
                pass
    return hit


def cmd_calm(_args):
    hit = signal_hogs(signal.SIGSTOP)
    if not hit:
        print("Nothing to suspend — no known bandwidth hogs running.")
        return 0
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    with open(STATE, "w") as fh:
        for label, pid in hit:
            fh.write(f"{pid}\t{label}\n")
    print(bold(f"Suspended {len(hit)} process(es):"))
    for label, pid in hit:
        print(f"  {green('⏸')}  {label} {dim(f'(pid {pid})')}")
    print()
    print(dim("These are paused, not killed. Run `hotspot restore` when you're back"))
    print(dim("on real wifi. iCloud Drive and Photos will not sync until you do."))
    return 0


def cmd_restore(_args):
    hit = signal_hogs(signal.SIGCONT)
    if os.path.exists(STATE):
        os.remove(STATE)
    print(bold(f"Resumed {len(hit)} process(es).") if hit else "Nothing was suspended.")
    for label, pid in hit:
        print(f"  {green('▶')}  {label} {dim(f'(pid {pid})')}")
    return 0


def suspended_count():
    try:
        with open(STATE) as fh:
            return sum(1 for line in fh if line.strip())
    except OSError:
        return 0


