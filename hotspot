#!/usr/bin/env python3
"""
hotspot — survival kit for working over an unstable iPhone Personal Hotspot.

Pure stdlib. No pip install, nothing to download — which is the point, since
you're reading this on a connection that can't be trusted to download anything.

  hotspot              live monitor + keep-alive (same as `watch`)
  hotspot watch        live monitor + keep-alive
  hotspot status       one-shot snapshot
  hotspot doctor       diagnose the link, recommend concrete fixes
                       (--no-speed skips the 2 MB throughput test)
  hotspot calm         suspend background bandwidth hogs (reversible)
  hotspot restore      resume everything `calm` suspended
  hotspot keepalive    quiet keep-alive only, safe to background
  hotspot mtu          find the real path MTU (why big transfers stall)
  hotspot wifi         list nearby networks, ranked by encryption
  hotspot trust        check if this network tampers with DNS/HTTPS/traffic
  hotspot dns fast     point DNS at 1.1.1.1 (carrier DNS is often the stall)
  hotspot dns auto     hand DNS back to DHCP
"""

