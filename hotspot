# ── intro ────────────────────────────────────────────────────────────────────
# Tail flicks on even frames, blinks on the third. Trailing spaces are load
# bearing: they wipe the previous frame's pixels as the cat moves right.
CAT = (
    (r" /\_/\ ", r"( o.o )", r"  > ^ <~"),
    (r" /\_/\ ", r"( o.o )", r"  > ^ < "),
    (r" /\_/\ ", r"( -.- )", r"  > ^ <~"),
    (r" /\_/\ ", r"( o.o )", r"  > ^ < "),
)
TIPS = ("waking the cat", "sniffing the link", "chasing packets")


def intro(done):
    """Walk a cat toward the signal until `done` is set.

    Cosmetic, but free: it runs while the first ping pair is in flight on
    another thread, so it fills dead time `watch` already spent on a blank
    screen. Skipped when stdout isn't a TTY, or when HOTSPOT_NO_CAT is set.
    """
    if not TTY or os.environ.get("HOTSPOT_NO_CAT"):
        done.wait(8)
        return

    cols = min(shutil.get_terminal_size((80, 24)).columns, 64)
    lane = max(6, cols - 22)
    start = time.time()
    # On a healthy link the warm-up pings return in ~50ms, so `done` alone
    # would end the intro before a single frame drew. Give the cat its walk,
    # but never hold the monitor hostage: hard ceiling at 8s.
    floor, ceiling = 1.7, 8.0
    try:
        while True:
            el = time.time() - start
            if el >= ceiling or (done.is_set() and el >= floor):
                break
            x = min(lane, int(el * lane / 1.5))          # walk, then arrive
            arrived = x >= lane
            body = CAT[int(el * 8) % len(CAT)]
            tip = TIPS[min(len(TIPS) - 1, int(el / 1.1))]

            # signal bars light up left-to-right as the cat closes in
            lit = min(4, int(el * 3)) if not arrived else 4
            sig = "".join((cyan if i < lit else dim)("|") for i in range(4))

            pad = " " * x
            frame = [
                "",
                f"  {' ' * (lane + 9)}{sig}",
                f"  {pad}{body[0]}",
                f"  {pad}{body[1]}",
                f"  {pad}{body[2]}",
                "",
                f"  {dim(tip + '…')}   ",
            ]
            sys.stdout.write("\033[H" + "\n".join(frame) + "\n")
            sys.stdout.flush()
            time.sleep(0.08)
    finally:
        if TTY:
            sys.stdout.write("\033[2J")
            sys.stdout.flush()


# ── watch ────────────────────────────────────────────────────────────────────
def cmd_watch(_args):
    info = link_info()
    if not info["iface"]:
        print(red("Offline — no default route."))
        return 1

    gw = Track("phone", info["gateway"])
    net = Track("internet", INTERNET)
    prev, prev_t = counters(info["iface"]), time.time()
    rin = rout = 0.0
    width = 46
    started = time.time()

    if TTY:
        sys.stdout.write("\033[?25l\033[2J")  # hide cursor, clear

    # Take the first sample pair on a thread so the intro overlaps the ~1-2.5s
    # it costs, instead of adding to it. The first rendered frame then already
    # has data in it.
    done, first = threading.Event(), {}

    def warm():
        try:
            first["gw"] = ping_once(info["gateway"], 1000)
            first["net"] = ping_once(INTERNET, 1500)
        finally:
            done.set()

    def mtu_check():
        # Deliberately not gated by `done`: on a capped link both probes time
        # out, and making the monitor wait ~2.5s for that would be a worse
        # trade than letting the verdict appear a moment after the first frame.
        # Cheap two-probe check only — the full bisect belongs to `hotspot mtu`.
        first["mtu_bad"] = mtu_capped(INTERNET)

    th = threading.Thread(target=warm, daemon=True)
    th.start()
    threading.Thread(target=mtu_check, daemon=True).start()
    intro(done)
    th.join(timeout=8)
    if "gw" in first:
        gw.add(first["gw"])
    if "net" in first:
        net.add(first["net"])
    seeded = bool(first)

    try:
        while True:
            cycle = time.time()
            if seeded:
                seeded = False  # warm-up already filled this cycle's samples
            else:
                gw.add(ping_once(info["gateway"], 1000))
                net.add(ping_once(INTERNET, 1500))

            now, cur = time.time(), counters(info["iface"])
            if cur and prev and now > prev_t:
                dt = now - prev_t
                rin = max(0, cur[0] - prev[0]) / dt
                rout = max(0, cur[1] - prev[1]) / dt
            prev, prev_t = cur, now

            lines = []
            label = info["port"] or info["iface"]
            kind = "USB tether" if is_usb_tether(info) else (
                "Wi-Fi hotspot" if is_hotspot(info) else "network")
            susp = suspended_count()
            head = f"{bold('hotspot')}  {label} · {kind} · gw {info['gateway']}"
            if susp:
                head += dim(f"  [{susp} paused]")
            lines += [head, ""]

            for t in (gw, net):
                v, col = verdict(t)
                med = f"{t.median:.0f}ms" if t.median else "—"
                jit = f"{t.jitter:.0f}ms" if t.jitter else "—"
                lines.append(
                    f"  {t.name:<9} {spark(t.samples, width, t.median)}  "
                    f"{col(v.ljust(5))}"
                )
                lines.append(
                    dim(f"  {'':<9} median {med:>7}   jitter {jit:>7}   "
                        f"loss {t.loss:>3.0f}%   {t.host}")
                )
                lines.append("")

            lines.append(f"  {'traffic':<9} ↓ {human_rate(rin)}   ↑ {human_rate(rout)}")
            lines.append("")
            d = diagnose(gw, net, info, first.get("mtu_bad"),
                         busy=(rin + rout) > 400_000, paused=susp)
            if d:
                col, head, acts = d
                for line in wrap(head, 68):
                    lines.append("  " + col(line))
                for a in acts:
                    for i, line in enumerate(wrap(a, 64)):
                        lines.append(dim(f"    {'→' if i == 0 else ' '} {line}"))
            lines.append("")
            lines.append(dim(f"  keep-alive active · {int(time.time() - started)}s · ctrl-c to stop"))

            if TTY:
                sys.stdout.write("\033[H")
                for line in lines:
                    sys.stdout.write("\033[2K" + line + "\n")
                sys.stdout.write("\033[J")
                sys.stdout.flush()
            else:
                # block-buffered when piped; flush or `watch > log` stays empty
                print(lines[0], flush=True)

            time.sleep(max(0.0, 1.0 - (time.time() - cycle)))
    except KeyboardInterrupt:
        pass
    finally:
        if TTY:
            sys.stdout.write("\033[?25h\n")
            sys.stdout.flush()
    return 0


# ── mtu ──────────────────────────────────────────────────────────────────────
def cmd_mtu(args):
    info = link_info()
    if not info["iface"]:
        print(red("Offline — no default route."))
        return 1
    host = args[0] if args else INTERNET

    print(f"{bold('hotspot mtu')}  probing {host} …")
    mtu, kind = probe_mtu(host)
    local = info.get("mtu")
    try:
        local = int(local)
    except (TypeError, ValueError):
        local = None
    print()

    if kind == "down":
        print(red("  Can't probe — even small pings are failing."))
        print(dim("  Fix the link first: `hotspot doctor`"))
        return 1
    if kind == "unknown" or not mtu:
        print(yellow("  Inconclusive. Results weren't consistent enough to trust."))
        return 1

    iface = info["iface"]
    for line in wrap(
            "Path MTU is the largest packet that survives the whole route. "
            "Anything bigger is dropped silently — no error, no warning — which "
            "is why transfers stall while ping stays perfect. The fix is to stop "
            "macOS sending packets bigger than the path accepts.", 72):
        print(dim(f"  {line}"))
    print()
    print(f"  path MTU       {bold(str(mtu))}   {dim('what the route accepts')}")
    print(f"  interface MTU  {local if local else '?'}   "
          f"{dim(f'what {iface} is sending')}")
    print()

    if kind == "ok" and (local or 1500) >= 1500:
        print(green("  Nothing to fix. Full-size packets get through."))
        return 0

    # Already lowered to match: this is the *fixed* state, not a fault. Saying
    # "1500 but the path only carries 1500" and offering a fix identical to the
    # undo is how the previous version read here.
    if local and local <= mtu:
        if local == mtu:
            print(green("  Matched — nothing is being dropped."))
            print(dim("  Your interface is already at the path limit. This is "
                      "the working state."))
        else:
            print(green("  Nothing is being dropped."))
            for line in wrap(f"Your interface ({local}) is below the path limit "
                             f"({mtu}) — safe, just slightly smaller packets "
                             f"than necessary.", 72):
                print(dim(f"  {line}"))
        print()
        print(yellow("  This does not persist."))
        for line in wrap(
                f"`ifconfig` MTU is reset whenever {iface} reconnects, so you "
                f"will need to set it again on each new hotspot session. Back on "
                f"real wifi you want the full 1500 — a {local} cap there is "
                f"harmless but pointlessly slower.", 72):
            print(f"  {line}")
        print()
        print(dim("  Back on real wifi:"))
        print(f"    sudo ifconfig {iface} mtu 1500")
        return 0

    print(red(f"  Mismatch — packets between {mtu + 1} and {local or 1500} bytes "
              f"are vanishing."))
    print()
    for line in wrap(
            f"{iface} is sending up to {local or 1500} bytes but the route only "
            f"carries {mtu}. The oversized ones disappear with no error, so "
            f"latency looks perfect while large transfers stall — SSH freezes "
            f"mid-session, pages half-load, git hangs near the end.", 72):
        print(f"  {line}")
    print()
    print(dim("  Fix:"))
    print(f"    sudo ifconfig {iface} mtu {mtu}")
    print()
    for line in wrap(f"Resets when {iface} reconnects, so re-run it each hotspot "
                     f"session. On real wifi, put it back:", 72):
        print(dim(f"  {line}"))
    print(dim(f"    sudo ifconfig {iface} mtu 1500"))
    return 0


# ── trust ────────────────────────────────────────────────────────────────────
def cmd_trust(_args):
    info = link_info()
    if not info["iface"]:
        print(red("Offline — no default route."))
        return 1

    note = dim("checking what this network does to your traffic …")
    print(f"{bold('hotspot trust')}  {note}\n")
    box = {}
    threads = [
        threading.Thread(target=lambda: box.update(portal=check_captive_portal()),
                         daemon=True),
        threading.Thread(target=lambda: box.update(dns=check_dns()), daemon=True),
        threading.Thread(target=lambda: box.update(tls=check_tls()), daemon=True),
    ]
    for t in threads:
        t.start()
    for t in threads:
        t.join(timeout=20)

    bad = 0
    portal = box.get("portal", "check did not finish")
    if portal is None:
        print(f"  {green('ok')}    captive portal   none — traffic reaches the "
              f"internet unmodified")
    else:
        bad += 1
        print(f"  {yellow('!!')}    captive portal   {portal}")

    dns_problems = box.get("dns")
    if dns_problems == []:
        print(f"  {green('ok')}    DNS              answers are not being rewritten")
    elif dns_problems is None:
        print(f"  {dim('--')}    DNS              check did not finish")
    else:
        bad += len(dns_problems)
        for p in dns_problems:
            head, *tail = wrap(p, 54)
            print(f"  {red('XX')}    DNS              {head}")
            for line in tail:
                print(f"                         {line}")

    tls = box.get("tls")
    if tls is None:
        print(f"  {dim('--')}    TLS              check did not finish")
    else:
        ok, org, detail = tls
        if ok is None:
            print(f"  {dim('--')}    TLS              {detail}")
        elif ok is False and detail:
            bad += 1
            print(f"  {red('XX')}    TLS              {detail}")
        elif ok is False:
            bad += 1
            print(f"  {red('XX')}    TLS              cloudflare.com is being "
                  f"served by “{org}”")
        else:
            print(f"  {green('ok')}    TLS              cloudflare.com served by "
                  f"{org} {dim('(a public CA)')}")
    print()

    if bad == 0:
        print(green("  Nothing is intercepting your traffic."))
    else:
        print(red("  This network is modifying your traffic."))
        if tls and tls[0] is False:
            for line in wrap("An unexpected certificate issuer means your HTTPS "
                             "is being decrypted and re-signed. Whoever runs "
                             "this network can read everything, including "
                             "passwords. Do not sign in to anything here.", 72):
                print(f"  {line}")
        elif portal is not None:
            for line in wrap("A captive portal intercepts traffic until you "
                             "accept its terms. That is normal for cafés and "
                             "hotels, but the portal page itself is a common "
                             "phishing surface — never enter a password you use "
                             "elsewhere.", 72):
                print(f"  {line}")
    print()
    for line in wrap("These checks prove specific things: that DNS answers are "
                     "intact, that HTTPS is not being re-signed, that traffic "
                     "is not redirected. A clean result does not mean the "
                     "operator is trustworthy — only that they are not doing "
                     "these particular things right now.", 72):
        print(dim(f"  {line}"))
    return 0 if bad == 0 else 1


# ── keepalive ────────────────────────────────────────────────────────────────
def cmd_keepalive(args):
    """Quiet trickle so the link never sits idle long enough to be torn down."""
    every = int(args[0]) if args and args[0].isdigit() else 15
    info = link_info()
    target = info["gateway"] or INTERNET
    print(dim(f"keep-alive → {target} every {every}s (ctrl-c to stop)"))
    try:
        while True:
            ping_once(target, 1000)
            ping_once(INTERNET, 1500)
            time.sleep(every)
    except KeyboardInterrupt:
        pass
    return 0


# ── main ─────────────────────────────────────────────────────────────────────
COMMANDS = {
    "watch": cmd_watch,
    "status": cmd_status,
    "doctor": cmd_doctor,
    "calm": cmd_calm,
    "restore": cmd_restore,
    "keepalive": cmd_keepalive,
    "dns": cmd_dns,
    "mtu": cmd_mtu,
    "wifi": cmd_wifi,
    "trust": cmd_trust,
}


def main(argv):
    if sys.platform != "darwin":
        print("hotspot is macOS-only.", file=sys.stderr)
        return 1
    cmd = argv[0] if argv else "watch"
    if cmd in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    fn = COMMANDS.get(cmd)
    if not fn:
        print(f"unknown command: {cmd}\n", file=sys.stderr)
        print(__doc__.strip(), file=sys.stderr)
        return 2
    return fn(argv[1:])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
