def cmd_dns(args):
    mode = args[0] if args else ""
    if mode not in ("fast", "auto"):
        print("usage: hotspot dns fast|auto")
        return 2
    info = link_info()
    port = info["port"]
    if not port:
        print(red("Could not determine the active network service."))
        return 1
    servers = ["1.1.1.1", "1.0.0.1"] if mode == "fast" else ["Empty"]
    cmd = ["networksetup", "-setdnsservers", port] + servers
    p = subprocess.run(cmd, capture_output=True, text=True, check=False)
    if p.returncode == 0:
        print(green(f"DNS for {port} → ") + (", ".join(servers) if mode == "fast" else "DHCP default"))
        return 0
    print(red("Needs admin rights. Run:"))
    print("  sudo " + " ".join(f'"{a}"' if " " in a else a for a in cmd))
    return 1


# ── doctor ───────────────────────────────────────────────────────────────────
def cmd_doctor(args):
    no_speed = "--no-speed" in (args or [])
    info = link_info()
    print(bold("Link"))
    if not info["iface"]:
        print(red("  No default route — you are offline."))
        return 1
    label = info["port"] or info["iface"]
    if info["ssid"]:
        label += f" · {info['ssid']}"

    # Both are passive and slow-ish (system_profiler and whois each take a few
    # seconds). Overlap them so the header costs one wait, not two.
    box = {}

    def guarded(fn, key):
        """Neither lookup is load-bearing. A failure should cost you that one
        line, not derail the report with a traceback through the middle of it."""
        def inner():
            try:
                box[key] = fn()
            except Exception:
                box[key] = {}
        return inner

    threads = [threading.Thread(target=guarded(wifi_info, "wifi"), daemon=True),
               threading.Thread(target=guarded(carrier_info, "car"), daemon=True)]
    for t in threads:
        t.start()

    print(f"  interface  {cyan(info['iface'])}  ({label})")
    print(f"  gateway    {info['gateway']}")
    print(f"  mtu        {info['mtu']}")

    for t in threads:
        t.join(timeout=20)
    wifi, car = box.get("wifi") or {}, box.get("car") or {}

    if car.get("name"):
        loc = f" · {car['country']}" if car.get("country") else ""
        print(f"  carrier    {cyan(car['name'])}{loc}   {dim(car.get('ip', ''))}")
    else:
        # Silently dropping the line just looks like the feature is missing.
        print(dim("  network    (couldn't identify — lookup blocked or offline)"))
    if wifi.get("rssi") is not None:
        word, wcol = signal_words(wifi.get("rssi"), wifi.get("snr"))
        band = f"{wifi['band']}GHz ch{wifi['channel']}" if wifi.get("band") else ""
        extra = " · ".join(x for x in (wifi.get("phy"), band) if x)
        detail = dim(f"{wifi['rssi']} dBm · SNR {wifi.get('snr', '?')} dB")
        print(f"  wi-fi      {wcol(word)}  {detail}   {dim(extra)}")

    speed = None
    if not no_speed:
        if TTY:  # \r only overwrites on a terminal; piped it would just linger
            print(dim("  speed      measuring…"), end="\r", flush=True)
        speed = speed_test()
        pad = "      " if TTY else ""
        if speed:
            mbps, nbytes, secs = speed
            print(f"  speed      {bold(f'{mbps:.1f} Mbps')} down"
                  f"   {dim(f'{nbytes/1e6:.1f} MB in {secs:.1f}s')}{pad}")
        else:
            print(dim(f"  speed      couldn't measure{pad}"))
    print()

    findings = []
    try:
        local_mtu = int(info["mtu"])
    except (TypeError, ValueError):
        local_mtu = None

    # A leftover cap from a tethering session. `ifconfig` MTU is not reset by
    # switching networks — only by the interface actually going down — so you
    # can land on ordinary wifi still capped and never notice.
    if local_mtu and local_mtu < 1500 and not is_hotspot(info):
        findings.append((
            "med",
            f"Interface MTU is still {local_mtu} on a network that isn't a hotspot.",
            f"Almost certainly left over from a tethering session — switching "
            f"networks does not reset it. Harmless, but needlessly slow here. "
            f"Restore it with `sudo ifconfig {info['iface']} mtu 1500`.",
        ))

    # Signal quality is about the Wi-Fi hop, which matters on any Wi-Fi network,
    # not only a hotspot.
    if wifi.get("rssi") is not None:
        word, _ = signal_words(wifi.get("rssi"), wifi.get("snr"))
        if word in ("weak", "very weak"):
            near = ("the phone" if is_hotspot(info) else "the router")
            findings.append((
                "high",
                f"Wi-Fi signal is {word} ({wifi['rssi']} dBm, SNR {wifi.get('snr','?')} dB).",
                f"This is the hop you fix by moving, and it is upstream of "
                f"everything else — get closer to {near}, or use a cable. Below "
                f"about -75 dBm the link starts retransmitting heavily, which "
                f"shows up as jitter rather than as lost packets.",
            ))

    if is_hotspot(info) and not is_usb_tether(info):
        findings.append((
            "high",
            "You are tethering over Wi-Fi.",
            "Plug the iPhone into the Mac with a cable. USB tethering removes the "
            "Wi-Fi hop entirely — no interference, no hotspot sleep, lower latency, "
            "and the phone charges. This is the single biggest win available to you.",
        ))
        # Already on 2.4GHz means Maximize Compatibility is on. Telling someone
        # to do a thing they have already done costs the tool its credibility.
        if wifi.get("band") != 2:
            findings.append((
                "med",
                "If you must stay on Wi-Fi, turn on Maximize Compatibility.",
                "iPhone → Settings → Personal Hotspot → Maximize Compatibility. "
                "Forces 2.4 GHz: lower ceiling, much better range and stability.",
            ))

    if is_hotspot(info):
        findings.append((
            "med",
            "Force LTE instead of 5G.",
            "Settings → Cellular → Cellular Data Options → Voice & Data → LTE. At "
            "the edge of coverage, 5G NSA flaps between bands constantly; LTE is "
            "slower on paper and far steadier in practice.",
        ))

    if info["mtu"] and info["mtu"] > 1420 and is_hotspot(info):
        findings.append((
            "low",
            f"MTU is {info['mtu']}.",
            "Tethered links sometimes silently drop full-size packets, which looks "
            "like random stalls. If you see big transfers hang while pings stay "
            f"clean, try: sudo ifconfig {info['iface']} mtu 1400",
        ))

    running = [(label_, name) for name, label_, exact in HOGS if find_pids(name, exact)]
    if running:
        findings.append((
            "high",
            f"{len(running)} background sync process(es) running: "
            + ", ".join(sorted({l for l, _ in running})) + ".",
            "These will happily eat your entire tether. Run `hotspot calm` to pause "
            "them, `hotspot restore` when you're back on real wifi.",
        ))

    findings.append((
        "med",
        "Enable Low Data Mode for this network.",
        "System Settings → Wi-Fi → (i) next to the hotspot → Low Data Mode. Stops "
        "macOS itself from doing background fetches and updates over the tether.",
    ))

    t0 = time.time()
    dns_ok = ping_once(INTERNET) is not None
    resolve_ms = None
    if dns_ok:
        t1 = time.time()
        run(["dscacheutil", "-q", "host", "-a", "name", "apple.com"], timeout=8)
        resolve_ms = (time.time() - t1) * 1000
        if resolve_ms > 400:
            findings.append((
                "med",
                f"DNS resolution took {resolve_ms:.0f} ms.",
                "Carrier DNS over a tether is often the real source of 'everything "
                "feels stuck'. Run `hotspot dns fast` to use 1.1.1.1.",
            ))

    if dns_ok:
        mtu, mkind = probe_mtu()
        # Only a finding while the interface is still oversized. Once it has
        # been lowered to match, there is nothing left to report.
        if mkind == "reduced" and mtu and (local_mtu is None or local_mtu > mtu):
            findings.append((
                "high",
                f"Path MTU is {mtu}, but the interface is set to {info['mtu']}.",
                f"Packets larger than {mtu} bytes are being dropped silently — no "
                f"error, no ICMP. Latency looks perfect while every large transfer "
                f"stalls: SSH freezes mid-session, pages half-load, git hangs near "
                f"the end. Run `sudo ifconfig {info['iface']} mtu {mtu}` to match "
                f"the path. See `hotspot mtu`.",
            ))

    print(bold("Findings"))
    order = {"high": 0, "med": 1, "low": 2}
    tag = {"high": red("●"), "med": yellow("●"), "low": dim("●")}
    for sev, title, fix in sorted(findings, key=lambda f: order[f[0]]):
        print(f"  {tag[sev]} {bold(title)}")
        for line in wrap(fix, 74):
            print(f"      {dim(line)}")
        print()
    if not findings:
        print(green("  Nothing to flag."))
    return 0


def wrap(text, width):
    words, line, out = text.split(), "", []
    for w in words:
        if len(line) + len(w) + 1 > width:
            out.append(line)
            line = w
        else:
            line = f"{line} {w}".strip()
    if line:
        out.append(line)
    return out


